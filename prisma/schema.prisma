generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Sonetto {
  id        String   @id @default(cuid())
  titolo    String
  testo     String
  createdAt DateTime @default(now())

  autore    String
  bersaglio String?

  reazioni  Reazione[]
}

model Reazione {
  id        String   @id @default(cuid())
  tipo      String
  createdAt DateTime @default(now())

  sonettoId String
  sonetto   Sonetto  @relation(fields: [sonettoId], references: [id], onDelete: Cascade)

  @@index([sonettoId])
}
